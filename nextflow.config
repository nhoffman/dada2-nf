// these values supersede params in the profile and are themselves
// superseded by contents of -params-file or command line args

nextflow.enable.dsl=2

// these can be overridden using command line args like
// --container dada2-nf:17.1
params {
    // Docker image is hosted on github
    container = "ghcr.io/nhoffman/dada2-nf:latest"
    min_reads = 1
    // number of threads per process; high_cpu processes scale concurrency
    // automatically via executor.cpus / nproc. nproc=8 is chosen because
    // dada2's multithreading shows diminishing returns beyond 8 threads —
    // it is more efficient to run more samples in parallel than to allocate
    // more threads per sample.
    nproc = 8
    cpus = 0  // total CPUs available; 0 = all available processors
    work_dir = "work"
}

manifest {
    homePage = 'https://github.com/nhoffman/dada2-nf'
    description = 'Nextflow pipeline for 16S/18S amplicon processing with DADA2'
    version = 'git describe --tags --dirty'.execute().text.trim()
    name = 'dada2-nf'
}

profiles {
    standard {
        workDir = params.work_dir
        resume = true  // null for no resume
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = 'singularity/'
        }
        params {
            output = 'output'
        }
        process {
            container = params.container
            executor = 'local'
            withLabel: high_cpu {
                cpus = Math.min(params.nproc, params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors())
            }
        }
        executor {
            cpus = params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors()
            queueSize = params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors()
        }
    }

    docker {
        workDir = params.work_dir
        resume = true  // null for no resume
        docker {
            enabled = true
        }
        params {
            output = 'output'
        }
        process {
            container = params.container
            executor = 'local'
            withLabel: high_cpu {
                cpus = Math.min(params.nproc, params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors())
            }
        }
        executor {
            cpus = params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors()
            queueSize = params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors()
        }
    }

    local {
        workDir = params.work_dir
        resume = true  // null for no resume
        params {
            output = 'output'
        }
        process {
            container = params.container
            executor = 'local'
            withLabel: high_cpu {
                cpus = Math.min(params.nproc, params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors())
            }
        }
        executor {
            cpus = params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors()
            queueSize = params.cpus > 0 ? params.cpus : Runtime.runtime.availableProcessors()
        }
    }

    uw_batch {
        workDir = 's3://molmicro-data/nextflow-workdir/dada2-nf'
        params {
            output = 'output'
        }
        process {
            scratch = "/docker_scratch"
            queue = 'molmicro-queue'
            executor = 'awsbatch'
            container = params.container

            // allocate resources according to labels; see
            // https://www.nextflow.io/docs/latest/config.html#scope-process
            // https://www.nextflow.io/docs/latest/process.html#label
            withLabel: med_cpu_mem {
                cpus = params.nproc
                memory = { t -> 8.GB * t.attempt }
                errorStrategy = 'retry'
                maxRetries = 3
            }
            withLabel: high_cpu {
                cpus = params.nproc
            }
        }
        aws {
            region = 'us-west-2'
            batch {
                volumes = '/docker_scratch'
                cliPath = '/home/ec2-user/miniconda/bin/aws'
            }
        }
    }
}
